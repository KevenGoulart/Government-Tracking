{
  "name": "@raio-x/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker de ingestão do Raio-X Público (NestJS standalone + BullMQ).",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json --exec \"node --env-file-if-exists=../../.env --enable-source-maps\"",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@raio-x/db": "workspace:*",
    "@raio-x/shared": "workspace:*",
    "bullmq": "^6.7.7",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@raio-x/eslint-config": "workspace:*",
    "@raio-x/tsconfig": "workspace:*",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
