{
  "name": "raio-x-publico",
  "private": true,
  "description": "Plataforma para explorar gastos públicos de parlamentares brasileiros a partir de dados abertos oficiais.",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @raio-x/db generate",
    "db:migrate": "pnpm --filter @raio-x/db migrate:dev",
    "db:deploy": "pnpm --filter @raio-x/db migrate:deploy",
    "prepare": "husky",
    "sync:initial": "turbo run build --filter=@raio-x/worker && pnpm --filter @raio-x/worker sync inicial"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3"
  }
}
