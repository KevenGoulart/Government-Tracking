# --- Banco de dados (Postgres via docker compose) ---
POSTGRES_USER=raiox
POSTGRES_PASSWORD=raiox
POSTGRES_DB=raiox
POSTGRES_PORT=5432
DATABASE_URL=postgresql://raiox:raiox@localhost:5432/raiox?schema=public

# --- Redis (filas BullMQ e cache) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (NestJS) ---
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
# Versão do código (ex.: SHA do commit), usada nas chaves de cache; opcional em desenvolvimento
APP_VERSION=

# --- Front-end (Next.js) ---
# URL da API usada no servidor (SSR/ISR) e no navegador
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Worker / ingestão ---
CAMARA_API_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
# Arquivos anuais da Cota Parlamentar (CSV zipado), fonte das despesas
CAMARA_COTAS_BASE_URL=https://www.camara.leg.br/cotas
# Legislatura usada para listar deputados (57 = 2023-2027)
CAMARA_LEGISLATURA=57
# Anos carregados na carga inicial (separados por vírgula)
SYNC_INITIAL_YEARS=2025,2026
# Requisições por segundo para a API da Câmara
CAMARA_RATE_LIMIT_PER_SECOND=3
# Habilita os jobs agendados (cron)
SYNC_CRON_ENABLED=true
# Enfileira a carga inicial quando o worker sobe com o banco vazio (ex.: deploy novo)
SYNC_INITIAL_ON_EMPTY_DB=true

# --- Senado ---
SENADO_API_BASE_URL=https://legis.senado.leg.br/dadosabertos
# Arquivos anuais da CEAPS (cota dos senadores), fonte das despesas do Senado
SENADO_CEAPS_BASE_URL=https://www.senado.leg.br/transparencia/LAI/verba
SENADO_LEGISLATURA=57

# --- Portal da Transparência (emendas parlamentares) ---
# Chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
# Sem a chave, a sincronização de emendas fica desabilitada (o resto funciona).
TRANSPARENCIA_API_KEY=
TRANSPARENCIA_API_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
TRANSPARENCIA_RATE_LIMIT_PER_SECOND=1
